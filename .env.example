# Local origin. In production use the public HTTPS origin, with no trailing slash.
APP_URL=http://localhost:3000

# Preview locally as sample admin Kael. Must be false for real login or production.
DEMO_MODE=false

# Generate a random value with: openssl rand -base64 48
# Required for real authentication; keep this secret and at least 32 characters long.
AUTH_SECRET=

# Discord Developer Portal > Applications > your application > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Turmoil Discord server ID. Discord Developer Mode > Copy Server ID.
DISCORD_GUILD_ID=

# Optional: require this role as well as server membership.
DISCORD_ROLE_ID=

# Optional: only this Discord user is automatically made the initial Admin.
# If empty, the first approved user becomes Admin.
INITIAL_ADMIN_DISCORD_ID=

# Required for production. Use the PostgreSQL provider's supported TLS URL.
# Empty in development uses durable PGlite at .data/turmoil.
DATABASE_URL=

# Optional local PGlite directory override. Demo defaults to .data/turmoil-demo.
LOCAL_DATABASE_PATH=
